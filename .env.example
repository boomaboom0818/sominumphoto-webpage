# Set on the Vercel project (Production and Preview).
# Create a public Blob store and connect it so Vercel injects the read-write token.
BLOB_READ_WRITE_TOKEN=
# Shared secret. The laptop uploader sends this in the X-Somnium-Token header.
SOMNIUM_UPLOAD_TOKEN=

# Set on the laptop that runs the Somnium FastAPI server. Not used by Vercel.
# SOMNIUM_UPLOAD_URL=https://your-domain.vercel.app/api/upload
# SOMNIUM_UPLOAD_TOKEN=same value as on Vercel
